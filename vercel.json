{
    "version": 2,
    "builds": [
        {
            "src": "App.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "App.py"
        }
    ],
    "functions": {
        "App.py": {
            "maxDuration": 60
        }
    }
}